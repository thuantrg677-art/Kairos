# Chép file này thành ".env.local" khi chạy trên máy,
# hoặc dán 2 dòng này vào Vercel → Settings → Environment Variables.
# Hai giá trị này được phép lộ ra trình duyệt (dữ liệu được bảo vệ bằng RLS).

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (bắt đầu bằng sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
